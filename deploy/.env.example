# Weaver独立部署 — 环境变量模板
# 复制到 deploy/.env 并填写所有必填项。

# --- 服务器基础 ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# --- 本地 Postgres（必填）---
POSTGRES_USER=weaver
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=weaver
DATABASE_URL=postgresql://weaver:change-me-strong-db-password@db:5432/weaver

# --- 会话安全（必填）---
# 32字节以上随机字符串，用于加密 JWT/会话 cookie。
SESSION_SECRET=change-me-32-char-random-secret-key

# --- 域名与 HTTPS ---
# 域名可留空，用 IP 访问；但 Let's Encrypt 需要真实域名。
WEAVER_DOMAIN=
WEAVER_EMAIL=your-email@example.com

# --- OpenRouter（Weaver AI 后端）---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/auto

# --- GitHub（可选，用于自我改进/上传）---
GITHUB_TOKEN=ghp_...
GITHUB_REPO_URL=https://github.com/username/weaver

# --- 所有者密码（唯一入口）---
WEAVER_OWNER_EMAIL=your-email@example.com
WEAVER_PASSCODE=change-me-very-strong-passcode

# --- 调度器密钥（可选）---
WEAVER_SCHEDULER_SECRET=change-me-random-scheduler-secret

# --- سر Runtime الداخلي (مطلوب للبناء والمعاينة) ---
# اتركه فارغاً في أول نشر وسيولّد server-deploy.sh قيمة عشوائية آمنة.
EXECUTOR_TOKEN=

# --- النسخ الاحتياطي التلقائي لقاعدة البيانات ---
# النسخ تُحفظ في /opt/weaver/backups (خارج مجلد النشر، لا تُمسح عند التحديث).
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
